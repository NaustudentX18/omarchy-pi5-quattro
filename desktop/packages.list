# ==============================================================================
# Omarchy Quattro Pi 5 - Arch Linux ARM Desktop Package List
# Target Architecture: aarch64 (Raspberry Pi 5 / BCM2712)
# ==============================================================================
# Usage:
#   pacman -S --needed - < <(grep -v '^#' packages.list | grep -v '^[[:space:]]*$')
# ==============================================================================

# ------------------------------------------------------------------------------
# Display & Compositor
# ------------------------------------------------------------------------------
# sway is the v1.0.2 default compositor. Hyprland is disabled until the Arch
# Linux ARM repos carry a self-consistent hyprland/aquamarine set (2026-09-08:
# repo hyprland needs libaquamarine.so=13, repo aquamarine ships soname 14).
sway
waybar
sddm
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
wl-clipboard
grim
slurp
foot
alacritty

# ------------------------------------------------------------------------------
# Browser
# ------------------------------------------------------------------------------
chromium

# ------------------------------------------------------------------------------
# GPU & Hardware Acceleration (Pi 5 VideoCore VII / Broadcom V3D)
# ------------------------------------------------------------------------------
mesa
vulkan-broadcom
libglvnd

# ------------------------------------------------------------------------------
# Audio & Media
# ------------------------------------------------------------------------------
pipewire
wireplumber
pipewire-pulse
pipewire-alsa
alsa-utils
mpv
brightnessctl
pamixer

# ------------------------------------------------------------------------------
# Network & Bluetooth
# ------------------------------------------------------------------------------
networkmanager
network-manager-applet
bluez
bluez-utils
blueman
wireless-regdb
openssh
# mDNS: avahi announces omarchy-pi5.local on the LAN; nss-mdns lets the Pi
# resolve other machines' .local hostnames
avahi
nss-mdns

# ------------------------------------------------------------------------------
# Shell & Core Tools
# ------------------------------------------------------------------------------
fastfetch
btop
eza
bat
fzf
ripgrep
fd
jq
neovim
tmux
zsh
sudo
polkit

# ------------------------------------------------------------------------------
# Fonts & Icons
# ------------------------------------------------------------------------------
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
ttf-jetbrains-mono-nerd-basic
otf-font-awesome
fontconfig

# ------------------------------------------------------------------------------
# Wayland / SDDM / Omarchy Desktop Companions
# ------------------------------------------------------------------------------
seatd
qt6-wayland
qt5-wayland
xdg-utils
xdg-user-dirs
starship
gum
uwsm
ydotool
wtype
# hyprpicker is compositor-agnostic (wlr-layer-shell) — works under sway too
hyprpicker

# ------------------------------------------------------------------------------
# System Maintenance & Desktop Essentials (audit fixes 2026-09-07)
# ------------------------------------------------------------------------------
parted
git
python-pip
polkit-gnome
fuzzel
mako
swaybg
upower
# ZRAM swap: 4GB/8GB zstd-compressed swap configured via /etc/systemd/zram-generator.conf
zram-generator

# ------------------------------------------------------------------------------
# Touch Screen & On-Screen Keyboard Support
# ------------------------------------------------------------------------------
squeekboard
libinput
